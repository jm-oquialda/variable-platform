# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of this app, used for magic link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix with NEXT_PUBLIC_ and never use in the app.
# Needed only to run the one-time talent import (npm run import:talent).
SUPABASE_SERVICE_ROLE_KEY=
